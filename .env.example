# Copia este fichero a ".env" y rellena las claves
DATA_DIR=/volume1/docker/nas-rag/data

# --- Embeddings (Voyage AI) ---
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4
EMBED_DIM=1024

# --- LLM de pago ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- LLM gratuitos (opcionales, API compatible con OpenAI) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
DEFAULT_PROVIDER=claude

# --- Transcripción local de audio/vídeo (faster-whisper) ---
WHISPER_MODEL=small
WHISPER_LANGUAGE=es

# --- Aplicación ---
APP_TOKEN=cambia-esto           # se envía en la cabecera X-API-Key (vacío = sin auth)
SCAN_INTERVAL=300               # segundos entre escaneos automáticos de la inbox (0 = desactivado)
